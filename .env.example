# ============================================================
# ASME India Competitive Intelligence System — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.
# ============================================================

# LLM Configuration
# Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
LLM_API_KEY=your_anthropic_or_openai_api_key_here
LLM_MODEL=claude-opus-4-6

# If using OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Tavily Search API
TAVILY_API_KEY=tvly-your_tavily_api_key_here
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Notion Integration
NOTION_API_KEY=secret_your_notion_integration_token_here
# Database: "Competitor Signals" — inside ASME Business Intelligence page
NOTION_DATABASE_ID=334a171803788014f95b7d5b7262639a8

# Output settings
TOP_SIGNALS_COUNT=10
